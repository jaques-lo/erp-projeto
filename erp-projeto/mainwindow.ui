  <property name="styleSheet">
   <string notr="true">#MainWindow {
    background-color: #050505;
}

QWidget {
    font-family: "Segoe UI", "DejaVu Sans", "Noto Sans", sans-serif;
    font-size: 10pt;
}

#centralwidget {
    background-color: #050505;
}

/* ---------- Barra de menus ---------- */
QMenuBar {
    background-color: #0b0b0b;
    color: #e8e8e8;
    border-bottom: 1px solid #262626;
    padding: 3px 6px;
}

QMenuBar::item {
    background: transparent;
    padding: 7px 14px;
    border-radius: 6px;
}

QMenuBar::item:selected {
    background-color: #222222;
    color: #ffffff;
}

QMenuBar::item:pressed {
    background-color: #2e2e2e;
}

QMenu {
    background-color: #111111;
    color: #e8e8e8;
    border: 1px solid #333333;
    border-radius: 8px;
    padding: 6px;
}

QMenu::item {
    padding: 8px 32px 8px 16px;
    border-radius: 6px;
}

QMenu::item:selected {
    background-color: #2a2a2a;
    color: #ffffff;
}

QMenu::item:disabled {
    color: #555555;
}

QMenu::separator {
    height: 1px;
    background: #2a2a2a;
    margin: 6px 8px;
}

/* ---------- Barra de ferramentas ---------- */
QToolBar {
    background-color: #0b0b0b;
    border: none;
    border-bottom: 1px solid #262626;
    spacing: 6px;
    padding: 6px 10px;
}

QToolBar::separator {
    background: #2a2a2a;
    width: 1px;
    margin: 4px 8px;
}

QToolButton {
    background-color: transparent;
    color: #e8e8e8;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 7px 16px;
    font-weight: bold;
}

QToolButton:hover {
    background-color: #1c1c1c;
    border: 1px solid #444444;
    color: #ffffff;
}

QToolButton:pressed {
    background-color: #2a2a2a;
}

/* ---------- Barra de status ---------- */
QStatusBar {
    background-color: #0b0b0b;
    color: #777777;
    border-top: 1px solid #262626;
}

QToolTip {
    background-color: #1a1a1a;
    color: #f5f5f5;
    border: 1px solid #444444;
    padding: 4px 8px;
}

/* ---------- Caixas de diálogo ---------- */
QMessageBox,
QDialog {
    background-color: #0d0d0d;
}

QMessageBox QLabel {
    color: #f0f0f0;
}</string>
