  <property name="styleSheet">
   <string notr="true">#MovimentacaoEstoqueWindow {
    background-color: #050505;
}

QWidget {
    font-family: "Segoe UI", "DejaVu Sans", "Noto Sans", sans-serif;
    font-size: 10pt;
}

/* ---------- Textos ---------- */
QLabel {
    color: #cfcfcf;
    background: transparent;
    font-weight: normal;
}

QLabel#lblTitulo {
    color: #ffffff;
    font-size: 18pt;
    font-weight: bold;
    padding-bottom: 10px;
    border-bottom: 1px solid #262626;
}

QLabel[role="section"] {
    color: #ffffff;
    font-size: 11pt;
    font-weight: bold;
}

QLabel[role="hint"] {
    color: #777777;
    font-size: 9pt;
}

QLabel[role="value"] {
    color: #ffffff;
    font-weight: bold;
}

QToolTip {
    background-color: #1a1a1a;
    color: #f5f5f5;
    border: 1px solid #444444;
    padding: 4px 8px;
}

/* ---------- Cartões / grupos ---------- */
QGroupBox {
    background-color: #0c0c0c;
    border: 1px solid #2a2a2a;
    border-radius: 12px;
    margin-top: 14px;
    padding: 20px 16px 14px 16px;
    color: #f2f2f2;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 14px;
    padding: 0 8px;
    color: #f2f2f2;
}

QFrame[variant="card"] {
    background-color: #0c0c0c;
    border: 1px solid #2a2a2a;
    border-radius: 12px;
}

QFrame#lineSep {
    background-color: #2a2a2a;
    border: none;
}

/* ---------- Campos de entrada ---------- */
QLineEdit,
QComboBox,
QAbstractSpinBox,
QDateEdit,
QDateTimeEdit {
    background-color: #141414;
    color: #f5f5f5;
    border: 1px solid #444444;
    border-radius: 8px;
    padding: 6px 10px;
    min-height: 22px;
    selection-background-color: #777777;
    selection-color: #ffffff;
    font-weight: normal;
}

QLineEdit:hover,
QComboBox:hover,
QAbstractSpinBox:hover,
QDateEdit:hover,
QDateTimeEdit:hover {
    border: 1px solid #666666;
}

QLineEdit:focus,
QComboBox:focus,
QAbstractSpinBox:focus,
QDateEdit:focus,
QDateTimeEdit:focus {
    border: 1px solid #d8d8d8;
    background-color: #181818;
}

QLineEdit:read-only,
QAbstractSpinBox:read-only {
    color: #bdbdbd;
}

QLineEdit:disabled,
QComboBox:disabled,
QAbstractSpinBox:disabled,
QDateEdit:disabled,
QDateTimeEdit:disabled {
    background-color: #0e0e0e;
    color: #666666;
    border: 1px solid #2a2a2a;
}

/* Campo de total (somente leitura, em destaque) */
QDoubleSpinBox[variant="total"] {
    font-size: 20pt;
    font-weight: bold;
    color: #ffffff;
    background-color: #0a0a0a;
    border: 1px solid #333333;
    padding: 8px 14px;
    min-height: 36px;
}

/* ---------- ComboBox / Data ---------- */
QComboBox {
    padding-right: 30px;
}

QComboBox::drop-down,
QDateEdit::drop-down,
QDateTimeEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 28px;
    border: none;
    background: transparent;
}

QComboBox::down-arrow,
QDateEdit::down-arrow,
QDateTimeEdit::down-arrow {
    image: none;
    width: 0px;
    height: 0px;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid #bdbdbd;
    margin-right: 8px;
}

QComboBox QAbstractItemView {
    background-color: #141414;
    color: #f5f5f5;
    border: 1px solid #444444;
    selection-background-color: #2e2e2e;
    selection-color: #ffffff;
    outline: 0;
}

/* ---------- SpinBox com botões ---------- */
QSpinBox {
    padding-right: 26px;
}

QSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 22px;
    border: none;
    background: transparent;
}

QSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 22px;
    border: none;
    background: transparent;
}

QSpinBox::up-arrow {
    image: none;
    width: 0px;
    height: 0px;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-bottom: 5px solid #bdbdbd;
}

QSpinBox::down-arrow {
    image: none;
    width: 0px;
    height: 0px;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #bdbdbd;
}

/* ---------- Calendário (popup do QDateEdit) ---------- */
QCalendarWidget QWidget {
    background-color: #141414;
    color: #f5f5f5;
}

QCalendarWidget QToolButton {
    background-color: transparent;
    color: #f5f5f5;
    border: none;
    padding: 4px 8px;
}

QCalendarWidget QAbstractItemView:enabled {
    background-color: #0d0d0d;
    color: #f5f5f5;
    selection-background-color: #f2f2f2;
    selection-color: #080808;
}

QCalendarWidget QAbstractItemView:disabled {
    color: #555555;
}

/* ---------- CheckBox ---------- */
QCheckBox {
    color: #e8e8e8;
    background: transparent;
    spacing: 10px;
    font-weight: normal;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #555555;
    border-radius: 5px;
    background-color: #141414;
}

QCheckBox::indicator:hover {
    border: 1px solid #999999;
}

QCheckBox::indicator:checked {
    background-color: #f2f2f2;
    border: 1px solid #f2f2f2;
}

/* ---------- Botões ---------- */
QPushButton {
    background-color: #1a1a1a;
    color: #e8e8e8;
    border: 1px solid #444444;
    border-radius: 8px;
    padding: 8px 22px;
    min-height: 22px;
    min-width: 92px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #262626;
    border: 1px solid #666666;
    color: #ffffff;
}

QPushButton:pressed {
    background-color: #333333;
}

QPushButton:disabled {
    background-color: #111111;
    color: #555555;
    border: 1px solid #2a2a2a;
}

QPushButton[variant="primary"] {
    background-color: #f2f2f2;
    color: #080808;
    border: 1px solid #f2f2f2;
}

QPushButton[variant="primary"]:hover {
    background-color: #d2d2d2;
    border: 1px solid #d2d2d2;
    color: #080808;
}

QPushButton[variant="primary"]:pressed {
    background-color: #aaaaaa;
    border: 1px solid #aaaaaa;
}

QPushButton[variant="danger"] {
    background-color: transparent;
    color: #ff9494;
    border: 1px solid #6b2f2f;
}

QPushButton[variant="danger"]:hover {
    background-color: #2a1212;
    color: #ffb4b4;
    border: 1px solid #a04444;
}

QPushButton[variant="danger"]:pressed {
    background-color: #3a1818;
}

QPushButton[variant="ghost"] {
    background-color: transparent;
    color: #bdbdbd;
    border: 1px solid #333333;
}

QPushButton[variant="ghost"]:hover {
    background-color: #1a1a1a;
    color: #ffffff;
    border: 1px solid #666666;
}

/* ---------- Tabelas ---------- */
QTableWidget,
QTableView {
    background-color: #0d0d0d;
    alternate-background-color: #131313;
    color: #e8e8e8;
    gridline-color: #232323;
    border: 1px solid #2a2a2a;
    border-radius: 10px;
    selection-background-color: #2f2f2f;
    selection-color: #ffffff;
    outline: 0;
}

QTableWidget::item,
QTableView::item {
    padding: 4px 8px;
    border: none;
}

QHeaderView {
    background-color: transparent;
}

QHeaderView::section {
    background-color: #1a1a1a;
    color: #bdbdbd;
    padding: 9px 10px;
    border: none;
    border-right: 1px solid #2a2a2a;
    border-bottom: 1px solid #333333;
    font-weight: bold;
}

QTableCornerButton::section {
    background-color: #1a1a1a;
    border: none;
}

/* ---------- Barras de rolagem ---------- */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #3a3a3a;
    border-radius: 3px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background: #5a5a5a;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background: #3a3a3a;
    border-radius: 3px;
    min-width: 28px;
}

QScrollBar::handle:horizontal:hover {
    background: #5a5a5a;
}

QScrollBar::add-line,
QScrollBar::sub-line {
    width: 0px;
    height: 0px;
}

QScrollBar::add-page,
QScrollBar::sub-page {
    background: transparent;
}

/* ---------- Caixas de diálogo abertas a partir da tela ---------- */
QMessageBox,
QDialog {
    background-color: #0d0d0d;
}

QMessageBox QLabel {
    color: #f0f0f0;
}</string>
