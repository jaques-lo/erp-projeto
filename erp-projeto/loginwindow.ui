  <property name="styleSheet">
   <string notr="true">#LoginWindow {
    background-color: #050505;
}

/* Labels */
QLabel {
    color: #e8e8e8;
    background: transparent;
}

#label,
#label_2 {
    color: #bdbdbd;
    font-size: 11pt;
    font-weight: bold;
}

#label_3 {
    color: #777777;
    font-size: 9pt;
}

/* Campos de texto */
QLineEdit {
    background-color: #141414;
    color: #f5f5f5;
    border: 1px solid #444444;
    border-radius: 8px;
    padding: 10px 12px;
    min-height: 20px;
    selection-background-color: #777777;
}

QLineEdit:hover {
    border: 1px solid #666666;
}

QLineEdit:focus {
    border: 1px solid #d8d8d8;
    background-color: #181818;
}

/* Botões */
QPushButton {
    background-color: #f2f2f2;
    color: #080808;
    border: none;
    border-radius: 8px;
    padding: 10px 24px;
    min-height: 20px;
    font-size: 11pt;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #d2d2d2;
}

QPushButton:pressed {
    background-color: #aaaaaa;
}

/* Botão Sair */
#btn_exit {
    background-color: transparent;
    color: #bdbdbd;
    border: 1px solid #444444;
}

#btn_exit:hover {
    background-color: #1a1a1a;
    color: #ffffff;
    border: 1px solid #666666;
}

#btn_exit:pressed {
    background-color: #242424;
}</string>
